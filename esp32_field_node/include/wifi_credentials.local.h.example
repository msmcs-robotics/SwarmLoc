// Local WiFi credential overrides (template).
//
// Copy to `wifi_credentials.local.h` and fill in real values. The .local.h
// file is gitignored so secrets do not ship.
//
//   cp include/wifi_credentials.local.h.example include/wifi_credentials.local.h
//   $EDITOR include/wifi_credentials.local.h
//
// Any #define here overrides the matching default in `wifi_credentials.h`.

#pragma once

// Open / captive-portal network — uncomment to override:
// #define WIFI_OPEN_SSID                "MSC - GUEST"

// WPA2-Enterprise PEAP / MSCHAPv2 — fill in for your campus / org:
// #define WIFI_ENT_SSID                 "UAA WiFi -MatSu"
// #define WIFI_ENT_IDENTITY             "yourusername"          // often same as username
// #define WIFI_ENT_USERNAME             "yourusername"
// #define WIFI_ENT_PASSWORD             "your-password-here"

// Behavior tweaks:
// #define WIFI_AUTO_CONNECT_ON_BOOT     1
// #define WIFI_CONNECT_TIMEOUT_MS       15000UL
// #define WIFI_RECONNECT_INTERVAL_MS    5000UL
